# Copy to .env and fill in. .env is gitignored.

# Postgres URL. Local Postgres:
#   postgresql://postgres:<password>@localhost:5432/whatspoppin
# (postgresql:// is fine; the worker adds the asyncpg driver for SQLAlchemy.)
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/whatspoppin

# Nicrron gateway key (nicrron.ai, OpenAI-compatible). Every model call goes through api.nicrron.ai:
# structured extraction (backend/llm), Jev-style classification (answered by a chat model, returned in
# Jev's answer shape) and embeddings (market search + the enrichment shortlist).
NICRRON_API_KEY=
NICRRON_MODEL=nicrron/auto     # or nicrron/fastest, nicrron/reasoning, or a pinned model id
# NICRRON_JEV_MODEL=           # model for classification only; defaults to NICRRON_MODEL
# NICRRON_EMBED_MODEL=voyage/voyage-finance-2   # embeddings; finance-tuned Voyage model by default

# Optional: TypeSafe API key (typesafe.ai) to run classification on the native Jev model instead of
# Nicrron. backend/llm's structured extraction still uses Nicrron. See docs.typesafe.ai/introduction.
TYPESAFE_API_KEY=

# NewsAPI key (newsapi.org -> Account -> API keys).
NEWSAPI_KEY=

# Kalshi API key ID (kalshi.com -> Account -> API keys). Optional: without it the Kalshi worker
# polls the public REST API every 10s instead of streaming over the WebSocket.
KALSHI_API_KEY_ID=

# Path to the private key PEM downloaded with the API key (RSA or Ed25519).
# Relative paths are from the repo root. *.pem is gitignored.
KALSHI_PRIVATE_KEY_PATH=kalshi_key.pem

# Kalshi categories to follow (Kalshi's own names). Every open market in them is stored,
# so search sees all of them; only the top KALSHI_MAX_MARKETS by 24h volume get live prices.
KALSHI_CATEGORIES=Economics,Financials,Companies,Commodities,Science and Technology,Mentions
KALSHI_MAX_MARKETS=1000
# Extra series tickers to follow, comma-separated. With no categories, only these are followed.
KALSHI_SERIES=

# X (Twitter) API bearer token for app-only auth (developer.x.com -> your
# app -> Keys and tokens -> Bearer Token). Used by
# backend/ingestion/twitter_lookup for on-demand account/keyword tweet
# lookups (recent-search + user-timeline endpoints).
X_BEARER_TOKEN=

# Alpaca Market Data API (free Basic plan). Create a key at
# app.alpaca.markets -> API Keys. Used by backend/ingestion/alpaca for
# on-demand stock price lookups (historical bars endpoint, IEX feed).
ALPACA_API_KEY_ID= 
ALPACA_API_SECRET_KEY= 

# --- Polymarket (global): public data, no keys needed --------------------------
# Gamma tag slugs to follow; the top POLYMARKET_MAX_MARKETS open markets by 24h volume.
POLYMARKET_TAGS=politics,economy,finance,tech,geopolitics
POLYMARKET_MAX_MARKETS=500

# --- Polymarket US: keys from polymarket.us/developer (verified account) -------
POLYMARKET_US_KEY_ID=
POLYMARKET_US_SECRET_KEY=        # base64 secret, shown once when you create the key
POLYMARKET_US_TAGS=politics,tech,crypto
POLYMARKET_US_MAX_MARKETS=200

# --- Alert detector (all optional; defaults shown) ---------------------------
# Lower Z_MIN / BURST_RATIO for a demo when real moves are rare.
# WINDOW_MIN + LOOKBACK_MIN + 5 must stay under the ingestion's 30-minute retention.
POLL_S=1                 # seconds between reads of new rows
WINDOW_MIN=5             # signal window
LOOKBACK_MIN=10          # max age of a quote that still counts as "the price"
STALE_S=120              # no new data this long = ingestion down, no alerts
NEAR_CLOSE_MIN=15        # skip markets closing sooner
MAX_SPREAD=0.10          # wider bid/ask = untrustworthy quote
SIGMA_FLOOR=0.01
MIN_SIGMA_SAMPLES=30
Z_MIN=3
MIN_BASELINE_MIN=60      # minutes of history a volume baseline needs
VOL_BASE_FLOOR=50
BURST_RATIO=5
MIN_BURST_NOTIONAL=300
WHALE_FLOOR=500
WHALE_THIN=1000
MIN_WHALE_SAMPLES=50
MIN_IMB_NOTIONAL=300
MIN_IMB_ORDERS=5
IMB_MIN=0.6
COOLDOWN_MIN=10

# --- Baseline job (python -m baselines) -----------------------------------------
BASELINE_DAYS=3            # history fetched per market (Polymarket US price history: 1 day)
BASELINE_REFRESH_HOURS=8   # recompute a market's baseline after this long
BASELINE_SWEEP_MIN=5       # how often to look for new or stale markets

# --- Company graph (python -m company_graph; see company_graph/company_graph.md) ---
# SEC rejects requests without a contact email in the User-Agent. Uses NEWSAPI_KEY above.
SEC_CONTACT_EMAIL=
GRAPH_LINK_TTL_DAYS=7        # how long stored links are reused before a rebuild
GRAPH_EVENT_WINDOW_DAYS=7    # how far back highlights look
GRAPH_MAX_LINKED=12          # most linked companies per graph
GRAPH_NEWS_TTL_HOURS=6       # how long one company's news result is reused
GRAPH_NEWS_DAILY_BUDGET=40   # most NewsAPI requests this feature may make per day (account-wide limit is 100)
GRAPH_BOARD_TTL_DAYS=7       # how long a company's stored board members are reused before a rebuild
GRAPH_BOARD_MAX_FILINGS=40   # most Form 3 / 4 filings read per board run, newest first (one SEC request each)
GRAPH_FAKE=0                 # 1 = serve company_graph/fixtures/ and board_fixtures/, and call no outside service
# GRAPH_LLM_MODEL=           # Nicrron model id; defaults to NICRRON_MODEL / nicrron/auto
# GRAPH_LLM_PROVIDER=anthropic   # call Claude directly for the company graph (needs ANTHROPIC_API_KEY)
# ANTHROPIC_API_KEY=
# GRAPH_ANTHROPIC_MODEL=claude-opus-5-5   # or claude-haiku-5-5 (much cheaper)
# X posts as highlight events (F12). Left out when X_BEARER_TOKEN above is unset. Jev (Nicrron) types the posts.
GRAPH_SOCIAL_TTL_HOURS=6     # how long one company's X search result is reused
GRAPH_SOCIAL_DAILY_BUDGET=20 # most X searches per day; each reads up to 100 posts, which X bills for
GRAPH_SOCIAL_MIN_LIKES=5     # posts with fewer likes are not sent to Jev
# News about two linked companies together (F13, GET /graph/{ticker}/news/{other}). Uses NEWSAPI_KEY, X_BEARER_TOKEN and Jev.
GRAPH_PAIR_TTL_HOURS=6       # how long one pair's result is reused
GRAPH_PAIR_DAILY_BUDGET=30   # most pair searches per day for each source (NewsAPI, X)

# --- Market enrichment + search API (see backend/enrichment/enrichment.md) -------
# Worker: uv run python -m backend.enrichment   API: uv run uvicorn backend.main:app
# Uses DATABASE_URL and NICRRON_API_KEY above. All optional; defaults shown.
ENRICH_BATCH=100             # events per sweep (one Jev run each, shared by its markets)
ENRICH_CONCURRENCY=4         # markets sent to Jev at once
ENRICH_THRESHOLD=0.5         # Jev yes-probability needed to tag an entity (pass 2)
ENRICH_CATEGORY_THRESHOLD=0.3  # lower bar for which categories get checked at all (pass 1)
ENRICH_SWEEP_S=60            # seconds between sweeps once caught up
ENRICH_SHORTLIST=12          # embedding shortlist: candidates per chosen category (0 = full two-pass walk)
# Relationship tags (F14; python -m company_graph.tags, a one-shot script, run on demand).
# Uses GRAPH_LLM_PROVIDER/GRAPH_LLM_MODEL or GRAPH_LLM_PROVIDER=anthropic + ANTHROPIC_API_KEY
# above -- no separate key of its own.

# --- Alert impact (python -m backend.alert_impact; see new_specs/alert-company-impact.md) ---
# Uses DATABASE_URL, and NICRRON_API_KEY to tag an alert's market on demand. Optional; defaults shown.
ALERT_IMPACT_MAX_COMPANIES=10   # companies stored per alert
ALERT_IMPACT_LOOKBACK_MIN=60    # on start, process alerts this recent that were missed
ALERT_IMPACT_JEV=1              # tier 3: ask Jev which companies each alert affects (0 = off)

# --- Voice assistant "Poppy" (backend/api/assistant.py) --------------------------
# ElevenLabs key (elevenlabs.io -> Profile -> API keys): speech-to-text (Scribe) and text-to-speech.
# Stays on the server; the browser only talks to /assistant/*. The brain is NICRRON_API_KEY above.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=XrExE9yKIg1WjnnlVkGX   # "Matilda"; any voice id from your ElevenLabs library
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v2

# --- PRISM run tracing (backend/observability/prism.py) ------------------------
# Every assistant turn and market search is recorded as a run with timed steps in
# .cache/prism/runs.jsonl. With the key (ingest scope, from PRISM's API keys page) and the
# project ID (Settings > Project), each run is also sent to PRISM as a trace with its steps.
PRISM_API_KEY=
PRISM_PROJECT_ID=
# PRISM_HOST=https://prism.blockconvey.com
